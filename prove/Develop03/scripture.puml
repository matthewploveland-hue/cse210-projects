@startuml Scripture

class Program {
    + Main()
    + Display()
}

class Scripture {
    - _scripture : List<Word>
    - _scriptureReference : Reference

    + AddScripture(string reference, string scripture)
    + HideRandomWords()
    + EndProgram(): bool
    + GetDisplayText(): string
}

class Word {
    - _text: string
    - _isHidden: bool

    + Word(string word)
    + HideWord() : 
    + IsHidden(): bool
    + GetDisplayText(): string

}

class Reference {
    - _book: string
    - _chapter: int
    - _startVerse: int
    - _endVerse: int
    
    + Reference(string book, int chapter, int startVerse)
    + Reference(string book, int chapter, int startVerse, int endVerse)
    + GetReference(): 
}

Program --> Scripture
Scripture --> Word
Scripture --> Reference

@enduml